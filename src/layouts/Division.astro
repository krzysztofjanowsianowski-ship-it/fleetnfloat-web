---
// Strona działu: nagłówek ze znakiem działu, treść działu, pozostałe działy i kontakt.
import Base from "./Base.astro";
import Mark from "../components/Mark.astro";
import Arrow from "../components/Arrow.astro";
import Sygnet from "../components/Sygnet.astro";
import ContactSection from "../components/ContactSection.astro";
import { dzialy, firma } from "../data/firma";

interface Props {
  id: string;
  lead: string;
  // Podstrona działu, np. Inwestycje w F&F HOMES: dodaje okruszek, tytuł i własny przycisk.
  podstrona?: { nazwa: string; akcja?: string };
  // Zakładki między stronami działu.
  zakladki?: { href: string; nazwa: string }[];
}

const { id, lead, podstrona, zakladki } = Astro.props;
const dzial = dzialy.find((d) => d.id === id)!;
const sciezka = Astro.url.pathname;
const pozostale = dzialy.filter((d) => d.id !== id);
---

<Base title={podstrona ? `${podstrona.nazwa} · ${dzial.marka} · ${firma.grupa}` : `${dzial.marka} · ${dzial.nazwa} · ${firma.grupa}`} description={`${dzial.marka}: ${dzial.krotko}`}>
  <section class="intro">
    <div class="wrap">
      <div class="intro-grid">
        <div>
          <nav class="crumbs" aria-label="Okruszki"><a href="/">Strona główna</a><span aria-hidden="true">»</span><a href="/#obszary">Obszary działalności</a><span aria-hidden="true">»</span>{podstrona ? <><a href={dzial.href}>{dzial.marka}</a><span aria-hidden="true">»</span><span>{podstrona.nazwa}</span></> : <span>{dzial.marka}</span>}</nav>
          <h1><Mark sufiks={dzial.sufiks} /></h1>
          <p class="lead">{(podstrona || id !== "lease") && <strong>{podstrona?.nazwa ?? dzial.nazwa}.</strong>} {lead}</p>
          {/* F&F LEASE: bez przycisku „Zapytaj o termin” w nagłówku. */}
          {id !== "lease" && <a class="button" href="#kontakt">{podstrona?.akcja ?? dzial.akcja} <Arrow /></a>}
        </div>
        <Sygnet class="intro-sygnet" />
      </div>
    </div>
  </section>

  {
    zakladki && (
      <nav class="tabs" aria-label={`Strony ${dzial.marka}`}>
        <div class="wrap">
          {zakladki.map((z) => (
            <a href={z.href} aria-current={sciezka.replace(/\/$/, "") === z.href.replace(/\/$/, "") ? "page" : undefined}>
              {z.nazwa}
            </a>
          ))}
        </div>
      </nav>
    )
  }

  <div class="body">
    <div class="wrap">
      <slot />
    </div>
  </div>

  <section class="others" aria-labelledby="pozostale-tytul">
    <div class="wrap">
      <h2 id="pozostale-tytul">Pozostałe działy grupy</h2>
      <ul>
        {
          pozostale.map((d) => (
            <li>
              <a href={d.href}>
                <Mark sufiks={d.sufiks} class="o-mark" />
                <span class="o-name">{d.nazwa}</span>
                <span class="o-go">Przejdź <Arrow /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactSection wybrany={id} tytul={`Kontakt · ${dzial.marka}`} opis="Napisz kilka zdań o tym, czego potrzebujesz. Odpowiemy na podany e-mail albo telefon." />
</Base>

<style>
  .intro {
    padding: 0 0 clamp(36px, 5vw, 64px);
    background: #fff;
    border-bottom: 1px solid var(--rule);
  }

  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px;
    align-items: center;
  }

  .intro :global(.intro-sygnet) {
    width: clamp(120px, 13vw, 180px);
  }

  .intro :global(.intro-sygnet circle:first-of-type) {
    stroke: var(--navy);
  }

  .intro :global(.intro-sygnet path) {
    fill: var(--navy);
  }

  .intro :global(.intro-sygnet circle:nth-of-type(2)) {
    stroke: var(--gold);
  }

  .crumbs {
    display: flex;
    gap: 12px;
    padding: 16px 0;
    font-size: 0.875rem;
    color: var(--navy);
    border-bottom: 1px solid var(--rule);
  }

  .crumbs a {
    color: var(--navy);
  }

  h1 {
    margin-top: clamp(28px, 3.4vw, 44px);
    font-size: clamp(2.25rem, 5vw, 4rem);
    line-height: 1.04;
    color: var(--navy);
  }

  .lead {
    margin: 20px 0 30px;
    max-width: 40em;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.6;
    color: #2b4466;
  }

  .lead strong {
    font-weight: 600;
    color: var(--navy-ink);
  }

  .body {
    padding: var(--step) 0;
  }

  .tabs {
    background: #fff;
    border-bottom: 1px solid var(--rule);
  }

  .tabs .wrap {
    display: flex;
    gap: clamp(20px, 3vw, 40px);
    overflow-x: auto;
  }

  .tabs a {
    padding: 16px 0 14px;
    white-space: nowrap;
    font: 600 0.875rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    color: #3d5373;
    border-bottom: 3px solid transparent;
  }

  .tabs a:hover {
    color: var(--navy);
  }

  .tabs a[aria-current="page"] {
    color: var(--navy);
    border-bottom-color: var(--gold);
  }

  .others {
    padding: clamp(48px, 6vw, 80px) 0;
    background: var(--beige);
    border-top: 1px solid var(--rule-soft);
  }

  .others h2 {
    font: 600 0.8125rem/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .others ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--gold);
  }

  .others li + li a {
    border-left: 1px solid var(--rule);
  }

  .others a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 22px 22px 24px;
    text-decoration: none;
    color: var(--navy);
    transition: background-color 0.25s;
  }

  .others a:hover {
    background: var(--paper);
  }

  .others :global(.o-mark) {
    font-size: 1.125rem;
  }

  .o-name {
    color: #2b4466;
  }

  .o-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font: 600 0.875rem/1 var(--sans);
    letter-spacing: 0.06em;
  }

  .o-go :global(svg) {
    width: 1em;
    height: 1em;
  }

  @media (max-width: 760px) {
    .intro-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .intro :global(.intro-sygnet) {
      display: none;
    }

    .others ul {
      grid-template-columns: 1fr;
    }

    .others li + li a {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
