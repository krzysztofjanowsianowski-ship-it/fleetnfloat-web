---
// Strona działu: nagłówek ze znakiem działu, treść działu, pozostałe działy i kontakt.
import Base from "./Base.astro";
import Mark from "../components/Mark.astro";
import Arrow from "../components/Arrow.astro";
import ContactSection from "../components/ContactSection.astro";
import { dzialy, firma } from "../data/firma";

interface Props {
  id: string;
  lead: string;
}

const { id, lead } = Astro.props;
const dzial = dzialy.find((d) => d.id === id)!;
const pozostale = dzialy.filter((d) => d.id !== id);
---

<Base title={`${dzial.marka} · ${dzial.nazwa} · ${firma.grupa}`} description={`${dzial.marka}: ${dzial.krotko}`}>
  <section class="intro">
    <div class="wrap">
      <nav class="crumbs" aria-label="Okruszki"><a href="/">{firma.grupa}</a><span aria-hidden="true">/</span><span>{dzial.marka}</span></nav>
      <p class="mark-line"><Mark sufiks={dzial.sufiks} /></p>
      <h1>{dzial.nazwa}</h1>
      <p class="lead">{lead}</p>
      <a class="button" href="#kontakt">{dzial.akcja} <Arrow /></a>
    </div>
  </section>

  <div class="body">
    <div class="wrap">
      <slot />
    </div>
  </div>

  <section class="others" aria-labelledby="pozostale-tytul">
    <div class="wrap">
      <h2 id="pozostale-tytul">Pozostałe działy grupy</h2>
      <ul>
        {
          pozostale.map((d) => (
            <li>
              <a href={d.href}>
                <Mark sufiks={d.sufiks} class="o-mark" />
                <span class="o-name">{d.nazwa}</span>
                <span class="o-go">Przejdź <Arrow /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <ContactSection wybrany={id} tytul={`Kontakt · ${dzial.marka}`} opis="Napisz kilka zdań o tym, czego potrzebujesz. Odpowiemy na podany e-mail albo telefon." />
</Base>

<style>
  .intro {
    padding: clamp(40px, 6vw, 88px) 0 clamp(48px, 6vw, 80px);
    background: var(--deep);
    border-bottom: 1px solid var(--rule-soft);
  }

  .crumbs {
    display: flex;
    gap: 10px;
    font-size: 0.875rem;
    color: #3d5373;
  }

  .crumbs a {
    color: var(--navy);
  }

  .mark-line {
    margin-top: clamp(28px, 4vw, 48px);
    font-size: clamp(1.125rem, 1.8vw, 1.5rem);
    color: var(--navy);
  }

  h1 {
    margin-top: 10px;
    font: 500 clamp(2.5rem, 5.4vw, 4.5rem) / 1.04 var(--serif);
    letter-spacing: -0.01em;
    color: var(--navy);
    text-wrap: balance;
  }

  .lead {
    margin: 22px 0 32px;
    max-width: 38em;
    font-size: clamp(1.125rem, 1.5vw, 1.3125rem);
    line-height: 1.55;
    color: #2b4466;
  }

  .body {
    padding: var(--step) 0;
  }

  .others {
    padding: clamp(48px, 6vw, 80px) 0;
    border-top: 1px solid var(--rule-soft);
  }

  .others h2 {
    font: 600 0.8125rem/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .others ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    margin: 22px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--navy);
  }

  .others li + li a {
    border-left: 1px solid var(--rule);
  }

  .others a {
    display: grid;
    gap: 8px;
    height: 100%;
    padding: 22px 22px 24px;
    text-decoration: none;
    color: var(--navy);
    transition: background-color 0.25s;
  }

  .others a:hover {
    background: var(--deep);
  }

  .others :global(.o-mark) {
    font-size: 1.125rem;
  }

  .o-name {
    color: #2b4466;
  }

  .o-go {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 6px;
    font: 600 0.875rem/1 var(--sans);
    letter-spacing: 0.06em;
  }

  .o-go :global(svg) {
    width: 1em;
    height: 1em;
  }

  @media (max-width: 760px) {
    .others ul {
      grid-template-columns: 1fr;
    }

    .others li + li a {
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }
</style>
