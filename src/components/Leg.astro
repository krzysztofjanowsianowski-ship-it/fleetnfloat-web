---
// Odcinek trasy: sekcja działu. Kilometr i przystanek siedzą na szynie
// marginesu, nagłówek po prawej; nazwy wodne kursywą, lądowe wersalikami.
interface Props {
  id: string;
  km: string;
  title: string;
  water?: boolean;
  tint: "water" | "land" | "deep";
}

const { id, km, title, water = false, tint } = Astro.props;
---

<section id={id} class:list={["leg", `tint-${tint}`]} aria-labelledby={`${id}-tytul`} data-leg>
  <div class="leg-inner">
    <div class="leg-head">
      <span class="kmark" aria-hidden="true">
        <span class="km">km {km}</span>
        <span class="stop"><i class="dot"></i><i class="seal"></i></span>
      </span>
      <h2 id={`${id}-tytul`} class:list={[water ? "water" : "land"]}>{title}</h2>
    </div>
    <slot />
  </div>
</section>

<style>
  .leg {
    position: relative;
    padding: var(--step) 0;
    border-top: 1px solid var(--rule);
  }

  .tint-water {
    background: var(--shoal);
    border-top: 1.2px solid var(--navy);
    border-bottom: 1.2px solid var(--navy);
  }

  .tint-land {
    background: var(--land) url("/chart/warstwice.svg") center / cover no-repeat;
  }

  .tint-deep {
    background: var(--deep);
  }

  .leg-inner {
    padding: 0 var(--gutter) 0 calc(var(--rail) + var(--gutter));
    max-width: 1440px;
  }

  .leg-head {
    position: relative;
    margin-bottom: clamp(28px, 3.4vw, 48px);
  }

  .kmark {
    position: absolute;
    left: calc(-1 * (var(--rail) + var(--gutter)));
    top: 0.55em;
    width: var(--rail);
    display: flex;
    align-items: center;
    justify-content: flex-end;
    font: 500 0.8125rem/1 var(--note);
    letter-spacing: 0.04em;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
  }

  .km {
    padding-right: 16px;
    white-space: nowrap;
  }

  .stop {
    position: relative;
    width: 0;
    height: 0;
  }

  .dot,
  .seal {
    position: absolute;
    left: 0;
    top: 0;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition: opacity 0.35s, background-color 0.35s;
  }

  .dot {
    width: 14px;
    height: 14px;
    background: var(--navy);
    box-shadow: 0 0 0 4px var(--deep), 0 0 0 5px var(--navy);
  }

  .seal {
    width: 30px;
    height: 30px;
    background: #fff;
    box-shadow: inset 0 0 0 4px var(--navy), inset 0 0 0 8px #fff, inset 0 0 0 9.5px var(--gold);
    opacity: 0;
  }

  :global(.leg.is-ahead) .dot {
    background: var(--deep);
    box-shadow: 0 0 0 1.5px var(--navy), 0 0 0 5px var(--deep);
  }

  :global(.leg.is-current) .seal {
    opacity: 1;
  }

  :global(.leg.is-current) .dot {
    opacity: 0;
  }

  h2 {
    color: var(--navy);
    text-wrap: balance;
  }

  h2.water {
    font: italic 500 clamp(2.25rem, 4.4vw, 3.75rem) / 1.05 var(--serif);
    letter-spacing: -0.01em;
  }

  h2.land {
    font: 500 clamp(1.75rem, 3.4vw, 3rem) / 1.1 var(--serif);
    letter-spacing: 0.09em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .km {
      display: none;
    }

    h2.land {
      font-size: 1.6rem;
      letter-spacing: 0.02em;
    }

    h2.water {
      font-size: 2.125rem;
    }
  }
</style>
