---
// Poglądowa sylwetka auta w kolorze lakieru (zamiast zdjęcia do czasu sesji zdjęciowej).
interface Props {
  nadwozie: "coupe" | "suv";
  lakier: string;
  dach?: string;
  tytul: string;
}

const { nadwozie, lakier, dach, tytul } = Astro.props;
const jasny = lakier.toLowerCase() === "#f4f4f2";
const obrys = jasny ? "#8a8f98" : "rgba(0,0,0,0.35)";
---

<svg viewBox="0 0 480 200" role="img" aria-label={tytul} class="car">
  <ellipse cx="240" cy="178" rx="210" ry="10" fill="rgba(32,58,95,0.12)"></ellipse>
  {
    nadwozie === "coupe" ? (
      <g>
        <path
          d="M28 150 C26 128 40 116 70 112 L150 104 C178 84 214 66 262 64 C304 63 336 74 362 96 L414 106 C440 110 454 122 454 140 L452 152 C452 158 446 160 440 160 L40 160 C32 160 28 156 28 150 Z"
          fill={lakier}
          stroke={obrys}
          stroke-width="1.5"
        />
        <path d="M168 104 C192 86 222 74 260 73 C296 72 322 82 344 100 L168 104 Z" fill="#23262c" />
        <path d="M258 74 L262 103" stroke={lakier} stroke-width="5" />
        <path d="M60 128 H120 M360 122 H430" stroke="rgba(255,255,255,0.35)" stroke-width="2" />
      </g>
    ) : (
      <g>
        <path
          d="M30 148 C28 124 40 112 68 108 L116 104 L148 64 C154 56 162 52 174 52 L332 52 C346 52 356 58 364 68 L392 104 L424 108 C444 112 454 124 454 142 L452 152 C452 158 446 160 440 160 L42 160 C34 160 30 156 30 148 Z"
          fill={lakier}
          stroke={obrys}
          stroke-width="1.5"
        />
        {dach && <path d="M150 62 C156 56 164 53 174 53 L332 53 C344 53 354 58 362 66 L366 72 L146 72 Z" fill={dach} />}
        <path d="M160 72 L134 104 H244 V72 Z M254 72 V104 H380 L356 72 Z" fill="#23262c" />
        <path d="M62 126 H122 M368 124 H430" stroke={jasny ? "rgba(32,58,95,0.25)" : "rgba(255,255,255,0.35)"} stroke-width="2" />
      </g>
    )
  }
  <g>
    <circle cx="118" cy="158" r="27" fill="#1e1f22"></circle>
    <circle cx="118" cy="158" r="14" fill="#b9bdc4"></circle>
    <circle cx="362" cy="158" r="27" fill="#1e1f22"></circle>
    <circle cx="362" cy="158" r="14" fill="#b9bdc4"></circle>
  </g>
</svg>

<style>
  .car {
    width: 100%;
    height: auto;
  }
</style>
