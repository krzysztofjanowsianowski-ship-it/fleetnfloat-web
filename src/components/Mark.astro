---
// Znak działu w notacji logo: „F&F” z kursywnym złotym ampersandem i nazwą działu.
interface Props {
  sufiks?: string;
  class?: string;
}

const { sufiks = " GROUP", class: className } = Astro.props;
---

<span class:list={["mark", className]}>F<span class="amp">&amp;</span>F{sufiks}</span>

<style>
  .mark {
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .amp {
    font-style: italic;
    color: var(--gold);
    letter-spacing: 0.02em;
    margin: 0 0.04em;
  }
</style>
