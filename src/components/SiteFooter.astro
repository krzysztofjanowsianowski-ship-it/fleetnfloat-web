---
import { dzialy, firma } from "../data/firma";

const rok = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="inner">
    <div class="about">
      <img src="/brand/logo-na-granacie.svg" alt="FLEET&FLOAT" width="2075" height="496" />
      <p>{firma.grupa}: cztery działy, jedna grupa.</p>
    </div>
    <nav aria-label="Działy w stopce">
      <h2>Działy</h2>
      <ul>
        {dzialy.map((d) => <li><a href={d.href}>{d.marka}</a> <span>{d.nazwa}</span></li>)}
      </ul>
    </nav>
    <div class="contact">
      <h2>Kontakt</h2>
      <dl>
        <div><dt>Adres</dt><dd>{firma.adres ?? <span class="draft-dark">[do uzupełnienia]</span>}</dd></div>
        <div><dt>Telefon</dt><dd>{firma.telefon ?? <span class="draft-dark">[do uzupełnienia]</span>}</dd></div>
        <div><dt>E-mail</dt><dd>{firma.email ?? <span class="draft-dark">[do uzupełnienia]</span>}</dd></div>
      </dl>
    </div>
    <p class="line"><span>© {rok} {firma.grupa} · {firma.nazwa}</span><span>{firma.haslo}</span></p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: #fff;
  }

  .inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr;
    gap: 40px 56px;
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(48px, 6vw, 80px) var(--gutter) 32px;
  }

  img {
    width: clamp(220px, 22vw, 300px);
    height: auto;
  }

  .about p {
    margin-top: 18px;
    max-width: 30ch;
    color: rgba(255, 255, 255, 0.78);
  }

  h2 {
    font: 600 0.75rem/1 var(--sans);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-on-navy);
    margin-bottom: 18px;
  }

  ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 12px;
  }

  li a {
    font: 500 1rem/1.3 var(--serif);
    letter-spacing: 0.1em;
    color: #fff;
    text-decoration: none;
  }

  li a:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold-on-navy);
  }

  li span {
    display: block;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  dl div {
    display: grid;
    grid-template-columns: 5.5rem 1fr;
    gap: 10px;
    padding: 6px 0;
  }

  dt {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  dd {
    margin: 0;
  }

  .draft-dark {
    color: #fff;
    border-bottom: 1px dashed rgba(255, 255, 255, 0.7);
    font-size: 0.9375rem;
  }

  .line {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 22px;
    border-top: 1px solid rgba(255, 255, 255, 0.22);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    color: rgba(255, 255, 255, 0.72);
  }

  .site-footer :focus-visible {
    outline-color: #fff;
  }

  @media (max-width: 860px) {
    .inner {
      grid-template-columns: 1fr;
    }
  }
</style>
