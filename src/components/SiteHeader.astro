---
import { dzialy } from "../data/firma";

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label="F&F GROUP, strona główna">
      <img src="/brand/braz/logo.svg" alt="" width="2075" height="496" />
    </a>
    <nav aria-label="Działy grupy">
      <ul>
        {
          dzialy.map((d) => (
            <li>
              <a href={d.href} aria-current={path.startsWith(d.href) ? "page" : undefined}>{d.marka}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="cta" href="/#kontakt">Kontakt</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--paper);
    border-bottom: 1px solid var(--rule-soft);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    max-width: var(--max);
    margin: 0 auto;
    padding: 14px var(--gutter);
  }

  .brand img {
    width: auto;
    height: clamp(40px, 4vw, 52px);
  }

  nav {
    margin-left: auto;
  }

  ul {
    display: flex;
    gap: clamp(16px, 2vw, 30px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    font: 500 0.9375rem/1 var(--serif);
    letter-spacing: 0.12em;
    color: var(--brown);
    text-decoration: none;
    padding: 8px 0;
    border-bottom: 1.5px solid transparent;
    transition: border-color 0.2s;
  }

  ul a:hover,
  ul a[aria-current="page"] {
    border-color: var(--gold);
  }

  .cta {
    font: 600 0.875rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--brown);
    text-decoration: none;
    padding: 12px 18px;
    border: 1.5px solid var(--brown);
    transition: background-color 0.2s, color 0.2s;
  }

  .cta:hover {
    background: var(--brown);
    color: #fff;
  }

  @media (max-width: 980px) {
    .bar {
      display: grid;
      grid-template-columns: 1fr auto;
      row-gap: 10px;
    }

    nav {
      grid-column: 1 / -1;
      grid-row: 2;
      margin-left: 0;
      overflow-x: auto;
    }

    ul {
      gap: 18px;
    }

    ul a {
      font-size: 0.8125rem;
      letter-spacing: 0.08em;
      white-space: nowrap;
    }

    .cta {
      padding: 10px 14px;
      white-space: nowrap;
    }
  }

  @media (max-width: 560px) {
    .site-header {
      position: static;
    }

    .bar {
      padding-top: 10px;
      padding-bottom: 10px;
    }

    ul {
      justify-content: space-between;
      gap: 10px;
    }

    ul a {
      font-size: 0.75rem;
      letter-spacing: 0.04em;
    }
  }
</style>
