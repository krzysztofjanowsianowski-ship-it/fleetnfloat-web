---
// Mapa trasy z pierwszego ekranu. Trasa jest podzielona na cztery odcinki
// (start → przystanek 1 → … → przystanek 4), żeby skrypt strony mógł rysować
// ją do wybranego działu. Bez JavaScriptu cała trasa jest narysowana.
import { dzialy } from "../data/firma";
import { ampersand } from "../data/ampersand";

const stations = [
  { x: 236, y: 300 },
  { x: 352, y: 604 },
  { x: 530, y: 590 },
  { x: 712, y: 712 },
];

const segments = [
  "M120 40 C140 120 170 200 236 300",
  "M236 300 C290 380 330 420 360 470 C380 520 330 560 352 604",
  "M352 604 C400 640 470 610 530 590",
  "M530 590 C590 572 610 620 640 660 C660 690 690 700 712 712",
];

const labels = [
  { x: 268, y: 292, anchor: "start", noteY: 316 },
  { x: 36, y: 556, anchor: "start", noteY: 580 },
  { x: 356, y: 650, anchor: "start", noteY: 674 },
  { x: 690, y: 754, anchor: "end", noteY: 774 },
];
---

<div class="chart" data-chart>
  <svg
    viewBox="0 0 752 778"
    preserveAspectRatio="xMidYMid meet"
    role="group"
    aria-label="Mapa trasy: cztery działy FLEET&FLOAT"
  >
    <defs>
      <symbol id="pieczec" viewBox="0 0 400 400">
        <circle cx="200" cy="200" r="184" fill="#fff" stroke="var(--navy)" stroke-width="32"></circle>
        <circle cx="200" cy="200" r="138" fill="none" stroke="var(--gold)" stroke-width="10"></circle>
        <path fill="var(--navy)" d={ampersand} transform="translate(200 200) scale(0.78) translate(-200 -200)"></path>
      </symbol>
      <pattern id="zabudowa" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
        <line x1="0" y1="0" x2="0" y2="6" stroke="#203A5F" stroke-width="0.8" opacity="0.35"></line>
      </pattern>
    </defs>

    <rect x="-700" y="-500" width="2150" height="1780" fill="var(--land)"></rect>

    <g class="contours" aria-hidden="true">
      <path d="M500 -400 C520 -200 500 -60 520 0 C560 120 700 160 752 150 C900 130 1100 180 1400 160"></path>
      <path d="M440 -400 C470 -200 450 -60 470 0 C510 150 680 200 752 196 C900 190 1100 230 1400 220"></path>
      <path d="M380 -400 C410 -200 400 -60 420 0 C460 170 660 240 752 246 C900 250 1100 280 1400 280"></path>
      <path d="M-700 660 C-400 640 -150 650 0 640 C120 600 210 650 300 778 C340 860 360 1000 380 1300"></path>
      <path d="M-700 720 C-400 700 -150 700 0 690 C90 660 170 700 230 778 C260 860 270 1000 280 1300"></path>
    </g>

    <g aria-hidden="true">
      <path
        d="M-700 120 C-400 110 -150 170 -10 160 C140 150 220 240 300 330 C380 420 520 400 600 330 C660 280 720 300 770 330 C950 360 1150 330 1450 350 L1450 500 C1150 480 950 500 770 470 C700 440 650 450 600 500 C500 590 360 590 270 480 C200 400 120 330 -10 330 C-150 340 -400 290 -700 300 Z"
        fill="var(--shoal)"></path>
      <path
        d="M-700 175 C-400 170 -150 215 -10 205 C130 200 210 280 290 370 C370 460 520 450 610 390 C670 350 720 365 770 390 C950 415 1150 395 1450 410 L1450 440 C1150 425 950 445 770 420 C710 400 670 410 615 450 C510 520 370 520 280 430 C210 360 120 280 -10 280 C-150 285 -400 245 -700 250 Z"
        fill="var(--deep)"></path>
      <path class="shore" d="M-700 120 C-400 110 -150 170 -10 160 C140 150 220 240 300 330 C380 420 520 400 600 330 C660 280 720 300 770 330 C950 360 1150 330 1450 350"></path>
      <path class="shore" d="M1450 500 C1150 480 950 500 770 470 C700 440 650 450 600 500 C500 590 360 590 270 480 C200 400 120 330 -10 330 C-150 340 -400 290 -700 300"></path>
      <g class="soundings">
        <text x="160" y="282">3₁</text><text x="235" y="352">2₈</text><text x="340" y="430">3₆</text>
        <text x="455" y="470">4₂</text><text x="560" y="438">3₃</text><text x="680" y="372">2₇</text>
      </g>
      <text class="water-name" x="40" y="250">szlak wodny</text>
      <g transform="translate(408 452) rotate(14)" class="lock">
        <rect x="-14" y="-28" width="28" height="56"></rect>
        <line x1="-14" y1="-10" x2="14" y2="-10"></line>
        <line x1="-14" y1="12" x2="14" y2="12"></line>
      </g>
      <text class="note" x="430" y="512">ŚLUZA</text>
      <path class="road-casing" d="M200 1300 C220 1000 240 860 250 778 C270 690 300 640 360 600 C430 555 520 560 570 520 C610 488 640 470 700 480 C900 510 1100 500 1450 520"></path>
      <path class="road" d="M200 1300 C220 1000 240 860 250 778 C270 690 300 640 360 600 C430 555 520 560 570 520 C610 488 640 470 700 480 C900 510 1100 500 1450 520"></path>
      <g fill="url(#zabudowa)" class="blocks">
        <rect x="652" y="640" width="40" height="44"></rect><rect x="718" y="650" width="28" height="44"></rect>
        <rect x="722" y="730" width="24" height="36"></rect><rect x="690" y="600" width="46" height="30"></rect>
        <rect x="626" y="690" width="32" height="26"></rect>
      </g>
      <g transform="translate(700 46)" class="north">
        <path d="M0 -26 L9 10 L0 4 L-9 10 Z"></path>
        <line x1="0" y1="4" x2="0" y2="22"></line>
        <text y="-34" text-anchor="middle">N</text>
      </g>
      <g transform="translate(40 728)" class="scale">
        <rect width="40" height="6" fill="var(--navy)"></rect>
        <rect x="40" width="40" height="6" fill="#fff" stroke="var(--navy)"></rect>
        <rect x="80" width="40" height="6" fill="var(--navy)"></rect>
        <text y="26">0</text><text x="112" y="26">3 km</text>
      </g>
    </g>

    <g class="route" aria-hidden="true">
      {
        segments.map((d, i) => (
          <g class="seg" data-seg={i}>
            <path class="seg-ghost" d={d} />
            <path class="seg-gold" d={d} pathLength="1" style={`--i:${i}`} />
            <path class="seg-dots" d={d} />
          </g>
        ))
      }
    </g>

    <g class="start" aria-hidden="true">
      <circle cx="120" cy="40" r="16" fill="var(--navy)"></circle>
      <circle cx="120" cy="40" r="10" fill="none" stroke="#fff" stroke-width="1.4"></circle>
      <text class="note" x="146" y="46">START · KM 0,0</text>
    </g>

    {
      dzialy.map((d, i) => {
        const s = stations[i];
        const l = labels[i];
        return (
          <a href={`#${d.id}`} class="station" data-dzial={d.id} aria-label={`${d.nazwa}: przejdź do opisu działu`}>
            <circle class="hit" cx={s.x} cy={s.y} r="30" />
            <g class="mark">
              <circle class="mark-ring" cx={s.x} cy={s.y} r="18" />
              <circle class="mark-dot" cx={s.x} cy={s.y} r="12" />
            </g>
            <use class="seal" href="#pieczec" x={s.x - 25} y={s.y - 25} width="50" height="50" />
            <text class={d.woda ? "label label-water" : "label label-land"} x={l.x} y={l.y} text-anchor={l.anchor}>
              {d.woda ? "Houseboaty BYGGA" : d.nazwa.toUpperCase()}
            </text>
            <text class="note label-note" x={l.x} y={l.noteY} text-anchor={l.anchor}>
              {`${d.miejsce.toUpperCase()} · KM ${d.km}`}
            </text>
            <text class="label-short" x={l.x} y={l.y} text-anchor={l.anchor}>
              {d.miejsce}
            </text>
          </a>
        );
      })
    }
  </svg>
</div>

<style>
  .chart {
    position: relative;
    height: 100%;
    min-height: 420px;
    background: var(--land);
  }

  .chart svg {
    width: 100%;
    height: 100%;
    overflow: hidden;
  }

  .contours path {
    fill: none;
    stroke: var(--navy);
    stroke-width: 0.7;
    opacity: 0.28;
  }

  .shore {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1.2;
  }

  .soundings text {
    font: italic 500 13px var(--serif);
    fill: var(--navy);
    opacity: 0.75;
  }

  .water-name {
    font: italic 500 22px var(--serif);
    letter-spacing: 3px;
    fill: var(--navy);
  }

  .lock rect,
  .lock line {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1.4;
  }

  .lock line {
    stroke-width: 2.2;
  }

  .note {
    font: 600 13px var(--note);
    letter-spacing: 1.5px;
    fill: var(--navy);
  }

  .road-casing {
    fill: none;
    stroke: var(--navy);
    stroke-width: 11;
  }

  .road {
    fill: none;
    stroke: var(--deep);
    stroke-width: 7;
  }

  .blocks rect {
    stroke: var(--navy);
    stroke-width: 1;
  }

  .scale text {
    font: 500 12px var(--note);
    letter-spacing: 1px;
    fill: var(--navy);
  }

  /* Trasa: duch odcinka zawsze widoczny, złoto rysowane do wybranego działu. */
  .seg-ghost {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1.2;
    stroke-dasharray: 3 7;
    opacity: 0.45;
  }

  .seg-gold {
    fill: none;
    stroke: var(--gold);
    stroke-width: 5;
    stroke-linecap: round;
    stroke-dasharray: 1 1;
    stroke-dashoffset: 0;
    transition: stroke-dashoffset 0.55s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .seg-dots {
    fill: none;
    stroke: #fff;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-dasharray: 0.5 22;
    transition: opacity 0.3s;
  }

  .seg.is-off .seg-gold {
    stroke-dashoffset: 1;
  }

  .seg.is-off .seg-dots {
    opacity: 0;
  }

  .chart.is-intro .seg-gold {
    transition-duration: 0.7s;
    transition-delay: calc(var(--i) * 0.42s + 0.2s);
  }

  .station {
    cursor: pointer;
    outline: none;
  }

  .hit {
    fill: transparent;
  }

  .mark-ring {
    fill: none;
    stroke: var(--navy);
    stroke-width: 1;
  }

  .mark-dot {
    fill: var(--navy);
  }

  .mark,
  .seal,
  .label,
  .label-note {
    transition: opacity 0.3s, fill 0.3s;
  }

  .seal {
    opacity: 0;
  }

  .north path {
    fill: var(--navy);
  }

  .north line {
    stroke: var(--navy);
    stroke-width: 1.2;
  }

  .north text {
    font: 600 13px var(--note);
    letter-spacing: 1px;
    fill: var(--navy);
  }

  .label-short {
    display: none;
    font: 600 34px var(--note);
    letter-spacing: 1px;
    fill: var(--navy);
  }

  .station.is-active .seal {
    opacity: 1;
  }

  .station.is-active .mark {
    opacity: 0;
  }

  .station.is-ghost .mark-dot {
    fill: var(--land);
    stroke: var(--navy);
    stroke-width: 1.2;
  }

  .station.is-ghost .label,
  .station.is-ghost .label-note {
    opacity: 0.45;
  }

  .label {
    fill: var(--navy);
  }

  .label-water {
    font: italic 500 26px var(--serif);
  }

  .label-land {
    font: 500 21px var(--serif);
    letter-spacing: 2.4px;
  }

  .station:focus-visible .seal {
    opacity: 1;
  }

  @media (max-width: 760px) {
    .chart {
      min-height: 0;
      aspect-ratio: 752 / 778;
    }

    /* Na telefonie nazwy działów są w legendzie tuż nad mapą:
       przystanki podpisujemy krótko, nazwą miejsca i kilometrem jak w legendzie. */
    .label,
    .label-note,
    .soundings,
    .water-name,
    .scale {
      display: none;
    }

    .label-short {
      display: inline;
    }

    .note {
      font-size: 26px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .seg-gold,
    .chart.is-intro .seg-gold {
      transition: none;
    }
  }
</style>
