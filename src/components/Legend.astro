---
// Legenda mapy: jest jednocześnie nawigacją po działach i miejscem ich akcji.
import { dzialy } from "../data/firma";
import Arrow from "./Arrow.astro";
---

<section class="legend" id="dzialy" aria-labelledby="legenda-tytul">
  <h2 id="legenda-tytul">Legenda</h2>
  <ul>
    {
      dzialy.map((d) => (
        <li class="row" data-dzial={d.id}>
          <span class="kmark" aria-hidden="true">km {d.km}</span>
          <svg class="sym" viewBox="0 0 30 30" aria-hidden="true">
            <g class="sym-dot">
              <circle cx="15" cy="15" r="7" fill="var(--navy)" />
              <circle cx="15" cy="15" r="11" fill="none" stroke="var(--navy)" stroke-width="1" />
            </g>
            <g class="sym-seal">
              <circle cx="15" cy="15" r="12" fill="#fff" stroke="var(--navy)" stroke-width="3" />
              <circle cx="15" cy="15" r="8" fill="none" stroke="var(--gold)" stroke-width="1.2" />
            </g>
          </svg>
          <a class:list={["name", { water: d.woda }]} href={`#${d.id}`}>
            {d.nazwa}
            <small>
              {d.miejsce} · {d.opis}
            </small>
          </a>
          <a class="action" href={`#kontakt`} data-zapytanie={d.id}>
            {d.akcja}
            <Arrow />
          </a>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .legend {
    border: 1.5px solid var(--navy);
    background: #fff;
  }

  h2 {
    display: flex;
    align-items: center;
    height: 40px;
    padding: 0 18px;
    border-bottom: 1px solid var(--rule);
    font: 600 0.8125rem/1 var(--note);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--navy);
  }

  ul {
    list-style: none;
    padding: 0;
  }

  .row {
    position: relative;
    display: grid;
    grid-template-columns: 30px 1fr auto;
    align-items: center;
    gap: 14px;
    min-height: 76px;
    padding: 10px 18px;
    border-bottom: 1px solid var(--rule-soft);
    transition: background-color 0.3s;
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row.is-active {
    background-color: rgba(184, 146, 90, 0.11);
  }

  .kmark {
    position: absolute;
    top: 50%;
    right: calc(100% + var(--gutter) + 1.5px);
    width: var(--rail);
    padding-right: 14px;
    transform: translateY(-50%);
    text-align: right;
    font: 500 0.8125rem/1 var(--note);
    letter-spacing: 0.04em;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .kmark::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 10px;
    height: 1px;
    background: var(--navy);
  }

  .sym {
    width: 30px;
    height: 30px;
  }

  .sym g {
    transition: opacity 0.3s;
  }

  .sym-seal,
  .row.is-active .sym-dot {
    opacity: 0;
  }

  .row.is-active .sym-seal {
    opacity: 1;
  }

  .name {
    font: 500 1.3125rem/1.22 var(--serif);
    color: var(--navy);
    text-decoration: none;
  }

  .name.water {
    font-style: italic;
  }

  .name:hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }

  .name small {
    display: block;
    margin-top: 4px;
    font: 500 0.8125rem/1.3 var(--note);
    font-style: normal;
    letter-spacing: 0.05em;
    color: #4a5f7d;
  }

  @media (max-width: 760px) {
    .kmark {
      display: none;
    }

    .row {
      grid-template-columns: 26px 1fr;
      row-gap: 10px;
      padding: 14px 16px;
    }

    .row .action {
      grid-column: 2;
      justify-self: start;
    }

    .sym {
      width: 26px;
      height: 26px;
    }
  }
</style>
