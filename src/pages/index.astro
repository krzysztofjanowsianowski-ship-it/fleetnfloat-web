---
import Base from "../layouts/Base.astro";
import Sidebar from "../components/Sidebar.astro";
import GroupDiagram from "../components/GroupDiagram.astro";
import ContactSection from "../components/ContactSection.astro";
import HouseboatProfile from "../components/HouseboatProfile.astro";
import VehiclesProfile from "../components/VehiclesProfile.astro";
import OfficeProfile from "../components/OfficeProfile.astro";
import ScreenProfile from "../components/ScreenProfile.astro";
import { dzialy } from "../data/firma";

const rysunki = {
  lease: VehiclesProfile,
  it: ScreenProfile,
  homes: HouseboatProfile,
  hr: OfficeProfile,
};
---

<Base
  title="F&F GROUP · FLEET&FLOAT · F&F LEASE, F&F.IT, F&F HOMES, F&F HR"
  description="Grupa F&F (FLEET&FLOAT): wynajem pojazdów, oprogramowanie dla firm, houseboaty i domy BYGGA oraz kadry i administracja."
>
  <div class="wrap">
    <nav class="crumbs" aria-label="Okruszki"><span>Strona główna</span><span aria-hidden="true">»</span><span>O grupie</span></nav>
  </div>

  <div class="wrap layout">
    <Sidebar />

    <div class="content">
      <section id="w-skrocie" aria-labelledby="w-skrocie-tytul">
        <h1 id="w-skrocie-tytul">W skrócie</h1>
        <p class="statement">
          Grupa F&F prowadzi działania w czterech obszarach: wynajem pojazdów, oprogramowanie dla firm, sprzedaż
          houseboatów i domów BYGGA oraz wsparcie kadrowe i administracyjne.
        </p>
        <p class="statement sub">W skład grupy należą:</p>
        <GroupDiagram />
        <p class="mission">
          Każdym obszarem zajmuje się osobny dział, a łączy je jedna marka FLEET&FLOAT i ten sam standard pracy:
          konkretnie, rzetelnie i z dbałością o jakość, niezależnie od tego, czy firma wynajmuje pojazd, zamawia
          oprogramowanie, kupuje dom czy powierza nam sprawy kadrowe.
        </p>
      </section>

      <section id="obszary" class="areas" aria-labelledby="obszary-tytul">
        <h2 id="obszary-tytul">Obszary działalności</h2>
        <p class="hint">Przejdź do odpowiedniego działu.</p>
        <ul class="tiles">
          {
            dzialy.map((d) => {
              const Rysunek = rysunki[d.id];
              return (
                <li>
                  <a class="tile" href={d.href}>
                    <span class="t-img" aria-hidden="true">
                      <Rysunek podpis={false} />
                    </span>
                    <span class="t-bar">
                      <span class="t-label">
                        <span class="t-mark">
                          F<span class="amp">&amp;</span>F{d.sufiks}
                        </span>
                        <span class="t-name">{d.nazwa}</span>
                      </span>
                      <svg class="chev" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 5l7 7-7 7M12 5l7 7-7 7" />
                      </svg>
                    </span>
                  </a>
                </li>
              );
            })
          }
        </ul>
        <p class="note">Rysunki są poglądowe.</p>
      </section>
    </div>
  </div>

  <ContactSection />
</Base>

<style>
  .crumbs {
    display: flex;
    gap: 12px;
    padding: 16px 0;
    font-size: 0.875rem;
    color: var(--navy);
    border-bottom: 1px solid var(--rule);
  }

  .layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(32px, 4vw, 56px);
    padding-top: 28px;
    padding-bottom: var(--step);
  }

  h1,
  h2 {
    font: 500 clamp(1.625rem, 2.4vw, 2rem) / 1.2 var(--sans);
    color: var(--navy-ink);
  }

  .statement {
    max-width: 44em;
    margin: 24px auto 0;
    text-align: center;
    font: 600 clamp(1.0625rem, 1.4vw, 1.1875rem) / 1.55 var(--sans);
    color: #5b6b80;
  }

  .statement.sub {
    margin-top: 6px;
    margin-bottom: 18px;
  }

  .mission {
    max-width: 46em;
    margin: 28px auto 0;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.7;
    color: #2b4466;
  }

  .areas {
    margin-top: clamp(56px, 7vw, 88px);
    padding-top: 28px;
    border-top: 1px solid var(--rule);
  }

  .hint {
    margin-top: 6px;
    color: #3d5373;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    display: block;
    text-decoration: none;
    color: #fff;
  }

  .t-img {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    padding: 6% 12%;
    background: var(--beige);
    overflow: hidden;
  }

  .t-img :global(figure) {
    width: 100%;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .t-img :global(.notes),
  .t-img :global(.leaders) {
    display: none;
  }

  .tile:hover .t-img :global(figure) {
    transform: scale(1.05);
  }

  .t-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 14px 12px 18px;
    background: var(--navy);
    transition: background-color 0.25s;
  }

  .tile:hover .t-bar {
    background: var(--navy-ink);
  }

  .t-label {
    display: grid;
    gap: 2px;
  }

  .t-mark {
    font: 500 1.0625rem/1.2 var(--serif);
    letter-spacing: 0.12em;
  }

  .amp {
    font-style: italic;
    color: var(--gold-on-navy);
  }

  .t-name {
    font-size: 0.8125rem;
    color: rgba(255, 255, 255, 0.82);
  }

  .chev {
    width: 26px;
    height: 26px;
    flex: none;
    fill: none;
    stroke: var(--gold-on-navy);
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile:hover .chev {
    transform: translateX(4px);
  }

  .note {
    margin-top: 14px;
    font-size: 0.8125rem;
    color: #4a5f7d;
  }

  @media (max-width: 900px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
      padding-top: 20px;
    }
  }

  @media (max-width: 600px) {
    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }

    .statement {
      text-align: left;
    }
  }
</style>
