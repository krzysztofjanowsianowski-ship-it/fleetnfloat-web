---
import Base from "../layouts/Base.astro";
import ChartMap from "../components/ChartMap.astro";
import Legend from "../components/Legend.astro";
import Leg from "../components/Leg.astro";
import HouseboatProfile from "../components/HouseboatProfile.astro";
import VehiclesProfile from "../components/VehiclesProfile.astro";
import ContactForm from "../components/ContactForm.astro";
import Arrow from "../components/Arrow.astro";
import External from "../components/External.astro";
import { firma, dzialy, modeleBygga } from "../data/firma";

const rok = new Date().getFullYear();
const dzial = Object.fromEntries(dzialy.map((d) => [d.id, d]));
---

<Base
  title="FLEET&FLOAT · Houseboaty BYGGA, wynajem pojazdów, oprogramowanie, kadry"
  description="FLEET&FLOAT: dealer houseboatów i domów BYGGA, wynajem pojazdów ciężarowych i osobowych, oprogramowanie dla firm oraz wsparcie kadrowe i administracyjne."
>
  <div class="sheet">
    <header class="masthead">
      <a class="brand" href="/" aria-label="FLEET&FLOAT, strona główna">
        <img src="/brand/logo.svg" alt="" width="2075" height="496" />
      </a>
      <nav aria-label="Główna">
        <a class="hide-sm" href="#dzialy">Działy</a>
        <a class="hide-sm" href="#realizacje">Realizacje</a>
        <a class="cta" href="#kontakt">Kontakt</a>
      </nav>
    </header>

    <main class="route" data-route>
      <div class="rail" aria-hidden="true"><span class="rail-fill" data-rail-fill></span></div>

      <section class="hero" aria-labelledby="tytul">
        <div class="hero-copy">
          <div class="hero-head">
            <span class="kmark" aria-hidden="true">km 0,0</span>
            <h1 id="tytul">Cztery usługi dla firm. <em>Jedna trasa,</em> ta sama solidność.</h1>
          </div>
          <p class="lede">
            Sprzedajemy houseboaty i domy BYGGA, wynajmujemy pojazdy, tworzymy oprogramowanie i wspieramy firmy w
            kadrach i administracji. Wybierz przystanek i przejdź od razu do konkretu.
          </p>
          <Legend />
        </div>
        <div class="hero-map">
          <ChartMap />
        </div>
      </section>

      <Leg id="houseboaty" km={dzial.houseboaty.km} title={dzial.houseboaty.nazwa} water tint="water">
        <div class="leg-grid">
          <div class="leg-text">
            <p class="lead">
              Jesteśmy dealerem BYGGA, producenta houseboatów i domów modułowych z Bydgoszczy, działającego od 2017 roku.
              Pomożemy dobrać model do miejsca i celu, a potem umówimy oględziny.
            </p>
            <table class="spis">
              <caption>Wybrane modele według producenta</caption>
              <thead>
                <tr><th scope="col">Model</th><th scope="col">Rodzaj</th><th scope="col">Część mieszkalna</th><th scope="col">Wymiary</th></tr>
              </thead>
              <tbody>
                {
                  modeleBygga.map((m) => (
                    <tr>
                      <th scope="row"><a href={m.url} rel="noopener" target="_blank">{m.model}<span class="visually-hidden"> (karta modelu u producenta, nowe okno)</span></a></th>
                      <td>{m.rodzaj}</td>
                      <td>{m.mieszkalna}</td>
                      <td>{m.wymiary}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
            <p class="fine">Dane z kart modeli na bygga.pl. Cenę, dostępność i transport potwierdzamy przy zapytaniu.</p>
            <div class="acts">
              <a class="button" href="#kontakt" data-zapytanie="houseboaty">{dzial.houseboaty.akcja} <Arrow /></a>
              <a class="action" href="https://www.bygga.pl/" rel="noopener" target="_blank">Pełna oferta producenta <External /><span class="visually-hidden"> (nowe okno)</span></a>
            </div>
          </div>
          <div class="leg-figure"><HouseboatProfile /></div>
        </div>
      </Leg>

      <Leg id="pojazdy" km={dzial.pojazdy.km} title={dzial.pojazdy.nazwa} tint="land">
        <div class="leg-grid">
          <div class="leg-text">
            <p class="lead">Samochody ciężarowe i osobowe na wynajem dla firm.</p>
            <h3>Do wyceny wystarczy nam</h3>
            <ul class="checklist">
              <li><b>Rodzaj pojazdu.</b> Ciężarowy czy osobowy, i ile sztuk.</li>
              <li><b>Termin.</b> Od kiedy i na jak długo.</li>
              <li><b>Miejsce odbioru.</b> Gdzie pojazd ma na Ciebie czekać.</li>
              <li><b>Cel.</b> Przewóz towaru, auto dla pracownika albo zastępstwo we flocie.</li>
            </ul>
            <div class="acts">
              <a class="button" href="#kontakt" data-zapytanie="pojazdy">{dzial.pojazdy.akcja} <Arrow /></a>
            </div>
          </div>
          <div class="leg-figure"><VehiclesProfile /></div>
        </div>
      </Leg>

      <Leg id="oprogramowanie" km={dzial.oprogramowanie.km} title={dzial.oprogramowanie.nazwa} tint="deep">
        <div class="leg-grid soft">
          <div class="leg-text">
            <p class="lead">
              Tworzymy narzędzia biurowe, systemy CRM, integracje między programami i platformy szkoleniowe dla firm.
            </p>
            <div class="case" id="realizacje">
              <h3>Realizacja: platforma kursów dla kierowców</h3>
              <ul class="facts">
                <li>Kursy obsługi tachografu cyfrowego i czasu pracy kierowcy.</li>
                <li>Interaktywny symulator tachografu VDO i Stoneridge z filmami instruktażowymi i lektorem.</li>
                <li>Panel firmy do zarządzania kierowcami i miesięczne rozliczenia.</li>
              </ul>
              <a class="action" href="https://kursy.fleetnfloat.com" rel="noopener" target="_blank">kursy.fleetnfloat.com <External /><span class="visually-hidden"> (nowe okno)</span></a>
            </div>
            <div class="acts">
              <a class="button" href="#kontakt" data-zapytanie="oprogramowanie">{dzial.oprogramowanie.akcja} <Arrow /></a>
            </div>
          </div>
          <figure class="inset">
            <div class="inset-bar"><span>Wstawka</span><span>kursy.fleetnfloat.com · symulator</span></div>
            <img
              src="/realizacje/kursy-symulator.webp"
              width="1600"
              height="778"
              loading="lazy"
              decoding="async"
              alt="Ekran symulatora tachografu VDO DTCO 4.1a na platformie kursów: wyświetlacz, przyciski, sloty kart, liczniki jazdy i przerwy."
            />
            <figcaption>Zrzut ekranu z platformy w trybie podglądu.</figcaption>
          </figure>
        </div>
      </Leg>

      <Leg id="kadry" km={dzial.kadry.km} title={dzial.kadry.nazwa} tint="land">
        <div class="leg-quiet">
          <p class="lead">
            Wspieramy przedsiębiorstwa w sprawach kadrowych i administracyjnych. Napisz, czego dotyczy sprawa, a
            zaproponujemy zakres współpracy.
          </p>
          <div class="acts">
            <a class="button" href="#kontakt" data-zapytanie="kadry">{dzial.kadry.akcja} <Arrow /></a>
          </div>
        </div>
      </Leg>

      <section class="contact" id="kontakt" aria-labelledby="kontakt-tytul" data-leg>
        <div class="leg-inner">
          <div class="contact-head">
            <span class="kmark end" aria-hidden="true"><span class="km">koniec trasy</span><span class="stop"><i class="dot"></i><i class="seal"></i></span></span>
            <h2 id="kontakt-tytul">Kontakt</h2>
            <p>Wybierz dział i napisz kilka zdań. Odpowiemy na podany e-mail albo telefon.</p>
          </div>
          <div class="contact-grid">
            <ContactForm />
            <aside class="firm" aria-label="Dane firmy">
              <img src="/brand/logo-bez-hasla.svg" alt="FLEET&FLOAT" width="2075" height="496" />
              <dl>
                <div><dt>Adres</dt><dd>{firma.adres ?? <span class="draft">[adres do uzupełnienia]</span>}</dd></div>
                <div><dt>NIP</dt><dd>{firma.nip ?? <span class="draft">[NIP do uzupełnienia]</span>}</dd></div>
                <div><dt>Telefon</dt><dd>{firma.telefon ? <a href={`tel:${firma.telefon.replace(/\s/g, "")}`}>{firma.telefon}</a> : <span class="draft">[telefon do uzupełnienia]</span>}</dd></div>
                <div><dt>E-mail</dt><dd>{firma.email ? <a href={`mailto:${firma.email}`}>{firma.email}</a> : <span class="draft">[e-mail do uzupełnienia]</span>}</dd></div>
              </dl>
            </aside>
          </div>
        </div>
      </section>
    </main>

    <footer class="foot">
      <div class="foot-inner">
        <img src="/brand/logo-na-granacie.svg" alt="FLEET&FLOAT" width="2075" height="496" />
        <nav aria-label="Działy w stopce">
          {dzialy.map((d) => <a href={`#${d.id}`}>{d.nazwa}</a>)}
        </nav>
        <p class="foot-line">
          <span>© {rok} {firma.nazwa}</span>
          <span>{firma.haslo}</span>
          <span>Arkusz 1 · strona główna</span>
        </p>
      </div>
    </footer>
  </div>
</Base>

<script>
  const order = ["houseboaty", "pojazdy", "oprogramowanie", "kadry"];
  const chart = document.querySelector<HTMLElement>("[data-chart]");
  const segs = chart ? [...chart.querySelectorAll<SVGGElement>(".seg")] : [];
  const stations = chart ? [...chart.querySelectorAll<SVGAElement>(".station")] : [];
  const rows = [...document.querySelectorAll<HTMLElement>(".legend .row")];
  const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Rysuje trasę do wybranego działu; bez wyboru cała trasa jest złota.
  function reach(id: string | null) {
    const k = id ? order.indexOf(id) : -1;
    segs.forEach((s, i) => s.classList.toggle("is-off", k >= 0 && i > k));
    stations.forEach((st, i) => {
      st.classList.toggle("is-active", i === k);
      st.classList.toggle("is-ghost", k >= 0 && i > k);
    });
    rows.forEach((r, i) => r.classList.toggle("is-active", i === k));
  }

  function bind(el: Element, id: string) {
    el.addEventListener("pointerenter", () => reach(id));
    el.addEventListener("pointerleave", () => reach(null));
    el.addEventListener("focusin", () => reach(id));
    el.addEventListener("focusout", () => reach(null));
  }

  rows.forEach((r) => bind(r, r.dataset.dzial ?? ""));
  stations.forEach((s) => bind(s, s.dataset.dzial ?? ""));

  if (chart && !calm) {
    chart.classList.add("is-intro");
    segs.forEach((s) => s.classList.add("is-off"));
    requestAnimationFrame(() =>
      requestAnimationFrame(() => {
        segs.forEach((s) => s.classList.remove("is-off"));
        setTimeout(() => chart.classList.remove("is-intro"), 2600);
      }),
    );
  }

  // Szyna na marginesie: złoto wypełnia przebytą trasę, przystanek w widoku dostaje pieczęć.
  const route = document.querySelector<HTMLElement>("[data-route]");
  const fill = document.querySelector<HTMLElement>("[data-rail-fill]");
  const legs = [...document.querySelectorAll<HTMLElement>("[data-leg]")];
  let ticking = false;

  function onScroll() {
    ticking = false;
    if (!route || !fill) return;
    const box = route.getBoundingClientRect();
    const mid = innerHeight * 0.55;
    const p = Math.min(1, Math.max(0, (mid - box.top) / box.height));
    fill.style.transform = `scaleY(${p})`;
    let current = -1;
    legs.forEach((l, i) => {
      if (l.getBoundingClientRect().top < mid) current = i;
    });
    legs.forEach((l, i) => {
      l.classList.toggle("is-current", i === current);
      l.classList.toggle("is-ahead", i > current);
    });
  }

  addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(onScroll);
      }
    },
    { passive: true },
  );
  addEventListener("resize", onScroll);
  onScroll();

  // Akcje działów wybierają dział w formularzu.
  const select = document.querySelector<HTMLSelectElement>("#f-dzial");
  document.querySelectorAll<HTMLElement>("[data-zapytanie]").forEach((a) =>
    a.addEventListener("click", () => {
      if (select && a.dataset.zapytanie) select.value = a.dataset.zapytanie;
    }),
  );
  const fromUrl = new URLSearchParams(location.search).get("dzial");
  if (select && fromUrl && order.includes(fromUrl)) select.value = fromUrl;

  // Walidacja i wysyłka formularza.
  const form = document.querySelector<HTMLFormElement>("[data-form]");
  const status = document.querySelector<HTMLElement>("[data-status]");

  function check(input: HTMLInputElement | HTMLTextAreaElement, ok: boolean) {
    const err = document.getElementById(input.getAttribute("aria-describedby") ?? "");
    input.setAttribute("aria-invalid", ok ? "false" : "true");
    if (err) err.hidden = ok;
    return ok;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const name = form.querySelector<HTMLInputElement>("#f-imie")!;
    const email = form.querySelector<HTMLInputElement>("#f-email")!;
    const msg = form.querySelector<HTMLTextAreaElement>("#f-wiad")!;
    const consent = form.querySelector<HTMLInputElement>("#f-zgoda")!;
    const results = [
      check(name, name.value.trim().length > 1),
      check(email, /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())),
      check(msg, msg.value.trim().length > 4),
      check(consent, consent.checked),
    ];
    if (results.includes(false)) {
      form.querySelector<HTMLElement>('[aria-invalid="true"]')?.focus();
      if (status) status.textContent = "Uzupełnij zaznaczone pola i wyślij ponownie.";
      return;
    }
    const endpoint = form.dataset.endpoint;
    if (!status) return;
    if (!endpoint) {
      status.textContent =
        "To wersja robocza strony: formularz zostanie podłączony do skrzynki firmy przed publikacją. Nic nie zostało wysłane.";
      return;
    }
    status.textContent = "Wysyłamy…";
    try {
      const res = await fetch(endpoint, { method: "POST", body: new FormData(form), headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(String(res.status));
      form.reset();
      status.textContent = `Dziękujemy. Zapytanie dotarło, odpowiemy na adres ${email.value.trim()}.`;
    } catch {
      status.textContent = "Nie udało się wysłać zapytania. Spróbuj ponownie za chwilę albo zadzwoń do nas.";
    }
  });
</script>

<style>
  .sheet {
    position: relative;
    margin: var(--frame);
    border: 1.5px solid var(--navy);
    background: var(--deep);
  }

  .sheet::before {
    content: "";
    position: absolute;
    inset: 5px;
    z-index: 4;
    border: 1px solid var(--navy);
    pointer-events: none;
    background:
      repeating-linear-gradient(90deg, var(--navy) 0 48px, transparent 48px 96px) top / 100% 5px no-repeat,
      repeating-linear-gradient(90deg, var(--navy) 0 48px, transparent 48px 96px) bottom / 100% 5px no-repeat,
      repeating-linear-gradient(180deg, var(--navy) 0 48px, transparent 48px 96px) left / 5px 100% no-repeat,
      repeating-linear-gradient(180deg, var(--navy) 0 48px, transparent 48px 96px) right / 5px 100% no-repeat;
  }

  .masthead {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: clamp(72px, 7vw, 96px);
    margin: 12px 12px 0;
    padding: 0 var(--gutter) 0 calc(var(--rail) + var(--gutter) - 12px);
    border-bottom: 1px solid var(--rule);
  }

  .brand img {
    width: auto;
    height: clamp(40px, 4.2vw, 58px);
  }

  .masthead nav {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.4vw, 32px);
    font: 600 0.9375rem/1 var(--note);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .masthead nav a {
    color: var(--navy);
    text-decoration: none;
  }

  .masthead nav a:not(.cta):hover {
    text-decoration: underline;
    text-decoration-color: var(--gold);
  }

  .masthead .cta {
    padding: 13px 18px;
    border: 1.5px solid var(--navy);
    transition: background-color 0.2s, color 0.2s;
  }

  .masthead .cta:hover {
    background: var(--navy);
    color: #fff;
  }

  .route {
    position: relative;
    margin: 0 12px 0;
  }

  .rail {
    position: absolute;
    left: var(--rail);
    top: 0;
    bottom: 0;
    width: 0;
    z-index: 2;
    pointer-events: none;
  }

  .rail::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: -0.5px;
    width: 1px;
    background: var(--rule);
  }

  .rail-fill {
    position: absolute;
    top: 0;
    bottom: 0;
    left: -2px;
    width: 4px;
    background: var(--gold);
    transform: scaleY(0);
    transform-origin: top;
  }

  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, calc(var(--rail) + var(--gutter) * 2 + 34rem)) minmax(0, 1fr);
    min-height: clamp(620px, calc(100svh - 120px), 860px);
  }

  .hero-copy {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    padding: clamp(32px, 4vw, 56px) var(--gutter) clamp(32px, 4vw, 48px) calc(var(--rail) + var(--gutter));
  }

  .hero-head {
    position: relative;
  }

  .kmark {
    position: absolute;
    left: calc(-1 * (var(--rail) + var(--gutter)));
    width: var(--rail);
    padding-right: 14px;
    text-align: right;
    font: 500 0.8125rem/1 var(--note);
    letter-spacing: 0.04em;
    color: var(--navy);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .hero-head .kmark {
    top: 0.9em;
  }

  .hero-head .kmark::after {
    content: "";
    position: absolute;
    right: 0;
    top: 50%;
    width: 10px;
    height: 1px;
    background: var(--navy);
  }

  h1 {
    font: 600 clamp(2.5rem, 4vw, 3.5rem) / 1.05 var(--serif);
    letter-spacing: -0.012em;
    color: var(--navy);
    text-wrap: balance;
  }

  h1 em {
    font-style: italic;
    font-weight: 500;
  }

  .lede {
    margin: 20px 0 clamp(24px, 3vw, 36px);
    max-width: 34em;
    font-size: 1.125rem;
    line-height: 1.55;
    color: #2b4466;
  }

  .hero-map {
    position: relative;
    border-left: 1px solid var(--rule);
  }

  .hero-map :global(.chart) {
    position: absolute;
    inset: 0;
  }

  /* Odcinki działów */
  .leg-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: start;
  }

  .leg-grid.soft {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .leg-text {
    max-width: 38rem;
  }

  .lead {
    font-size: clamp(1.1875rem, 1.6vw, 1.375rem);
    line-height: 1.5;
    color: var(--navy-ink);
    max-width: 36em;
  }

  .leg-figure {
    padding-top: 8px;
  }

  .acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
    margin-top: clamp(28px, 3vw, 40px);
  }

  .spis {
    width: 100%;
    margin-top: 32px;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .spis caption {
    text-align: left;
    padding-bottom: 10px;
    font: 600 0.8125rem/1.2 var(--note);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .spis th,
  .spis td {
    padding: 11px 14px 11px 0;
    text-align: left;
    vertical-align: baseline;
    border-bottom: 1px solid var(--rule);
  }

  .spis thead th {
    font: 600 0.75rem/1.2 var(--note);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #3d5373;
    border-bottom: 1.5px solid var(--navy);
  }

  .spis tbody th {
    font: italic 500 1.125rem/1.3 var(--serif);
  }

  .spis tbody th a {
    color: var(--navy);
    text-decoration-color: var(--gold);
  }

  .spis td {
    font: 500 0.9375rem/1.35 var(--note);
    color: var(--navy-ink);
  }

  .fine {
    margin-top: 12px;
    font: 500 0.875rem/1.45 var(--note);
    letter-spacing: 0.02em;
    color: #3d5373;
  }

  h3 {
    margin-top: 32px;
    font: 600 0.875rem/1.2 var(--note);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--navy);
  }

  .checklist {
    margin-top: 14px;
    padding: 0;
    list-style: none;
    border-top: 1.5px solid var(--navy);
  }

  .checklist li {
    position: relative;
    padding: 14px 0 14px 34px;
    border-bottom: 1px solid var(--rule);
    font-size: 1.0625rem;
    line-height: 1.5;
  }

  .checklist li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 1.55em;
    width: 16px;
    height: 1.5px;
    background: var(--gold);
  }

  .checklist b {
    font-weight: 600;
    color: var(--navy);
  }

  .case {
    margin-top: 32px;
    padding-top: 4px;
  }

  .case h3 {
    margin-top: 0;
    font: italic 500 1.5rem/1.25 var(--serif);
    letter-spacing: 0;
    text-transform: none;
  }

  .facts {
    margin: 16px 0 20px;
    padding: 0;
    list-style: none;
  }

  .facts li {
    position: relative;
    padding: 10px 0 10px 24px;
    border-bottom: 1px solid var(--rule-soft);
    line-height: 1.5;
  }

  .facts li::before {
