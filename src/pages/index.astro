---
import Base from "../layouts/Base.astro";
import Mark from "../components/Mark.astro";
import Arrow from "../components/Arrow.astro";
import ContactSection from "../components/ContactSection.astro";
import HouseboatProfile from "../components/HouseboatProfile.astro";
import VehiclesProfile from "../components/VehiclesProfile.astro";
import OfficeProfile from "../components/OfficeProfile.astro";
import ScreenProfile from "../components/ScreenProfile.astro";
import { dzialy } from "../data/firma";
import Sygnet from "../components/Sygnet.astro";

const rysunki = {
  lease: VehiclesProfile,
  it: ScreenProfile,
  homes: HouseboatProfile,
  hr: OfficeProfile,
};
---

<Base
  title="F&F GROUP · FLEET&FLOAT · F&F LEASE, F&F.IT, F&F HOMES, F&F HR"
  description="Grupa F&F (FLEET&FLOAT): wynajem pojazdów, oprogramowanie dla firm, houseboaty i domy BYGGA oraz kadry i administracja."
>
  <section class="hero" aria-labelledby="tytul">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <Sygnet class="hero-sygnet-sm" />
        <h1 id="tytul"><Mark sufiks=" GROUP" /></h1>
        <p class="lead">
          Grupa F&F prowadzi działania w czterech obszarach: wynajem pojazdów, oprogramowanie dla firm, sprzedaż
          houseboatów i domów BYGGA oraz wsparcie kadrowe i administracyjne. Każdym zajmuje się osobny dział, a łączy je
          jedna marka i ten sam standard pracy.
        </p>
        <div class="hero-acts">
          <a class="button light" href="#dzialy">Przejdź do odpowiedniego działu <Arrow /></a>
          <a class="hero-link" href="#kontakt">Kontakt</a>
        </div>
      </div>
      <Sygnet class="hero-sygnet" />
    </div>
  </section>

  <section class="divisions" id="dzialy" aria-labelledby="dzialy-tytul">
    <div class="wrap">
      <div class="sec-head">
        <h2 id="dzialy-tytul">W skład grupy należą</h2>
        <p>Przejdź do odpowiedniego działu.</p>
      </div>
      <ul class="tiles">
        {
          dzialy.map((d) => {
            const Rysunek = rysunki[d.id];
            return (
              <li>
                <a class="tile" href={d.href}>
                  <Mark sufiks={d.sufiks} class="t-mark" />
                  <span class="t-name">{d.nazwa}</span>
                  <span class="t-text">{d.krotko}</span>
                  <span class="t-art" aria-hidden="true">
                    <Rysunek podpis={false} />
                  </span>
                  <span class="t-go">
                    Przejdź do działu <Arrow />
                  </span>
                </a>
              </li>
            );
          })
        }
      </ul>
      <p class="note">Rysunki są poglądowe.</p>
    </div>
  </section>

  <ContactSection />
</Base>

<style>
  .hero {
    background: var(--brown);
    color: #fff;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
    padding-top: clamp(56px, 8vw, 120px);
    padding-bottom: clamp(56px, 8vw, 120px);
  }

  h1 {
    font-size: clamp(2.25rem, 6.6vw, 5.75rem);
    line-height: 1;
    color: #fff;
  }

  h1 :global(.amp) {
    color: var(--gold-on-dark);
  }

  .lead {
    margin-top: clamp(24px, 3vw, 36px);
    max-width: 36em;
    font-size: clamp(1.125rem, 1.6vw, 1.375rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.88);
  }

  .hero-acts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 18px 28px;
    margin-top: clamp(28px, 3.4vw, 44px);
  }

  .button.light {
    color: var(--brown);
    background: var(--paper);
    box-shadow: inset 0 0 0 4px var(--paper), inset 0 0 0 5px var(--brown);
  }

  .button.light:hover {
    background: var(--deep);
    box-shadow: inset 0 0 0 4px var(--deep), inset 0 0 0 5px var(--brown);
  }

  .hero-link {
    font: 600 0.9375rem/1 var(--sans);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
    padding-bottom: 4px;
    border-bottom: 1.5px solid rgba(255, 255, 255, 0.6);
    text-decoration: none;
  }

  .hero-link:hover {
    border-color: #fff;
  }

  .hero :focus-visible {
    outline-color: #fff;
  }

  .hero :global(.hero-sygnet) {
    width: 100%;
    max-width: 360px;
    justify-self: end;
  }

  .hero :global(.hero-sygnet-sm) {
    display: none;
  }

  .t-art :global(.notes),
  .t-art :global(.leaders) {
    display: none;
  }

  .divisions {
    padding: var(--step) 0;
  }

  .sec-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px 32px;
    padding-bottom: 22px;
    border-bottom: 1px solid var(--gold);
  }

  .sec-head h2 {
    font: 500 clamp(1.75rem, 3vw, 2.5rem) / 1.15 var(--serif);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--brown);
  }

  .sec-head p {
    font-size: 1.125rem;
    color: #4a3b2f;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin: clamp(28px, 3vw, 40px) 0 0;
    padding: 0;
    list-style: none;
  }

  .tile {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
    grid-template-rows: auto auto 1fr auto;
    column-gap: 24px;
    height: 100%;
    padding: clamp(24px, 3vw, 36px);
    background: var(--paper);
    border: 1px solid var(--rule);
    color: var(--brown);
    text-decoration: none;
    transition: border-color 0.25s, box-shadow 0.3s, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile::before {
    content: "";
    position: absolute;
    left: -1px;
    right: -1px;
    top: -1px;
    height: 3px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile:hover {
    border-color: var(--brown);
    box-shadow: 0 18px 36px -24px rgba(44, 35, 28, 0.45);
    transform: translateY(-2px);
  }

  .tile:hover::before,
  .tile:focus-visible::before {
    transform: scaleX(1);
  }

  .tile :global(.t-mark) {
    grid-column: 1 / -1;
    font-size: clamp(1.5rem, 2.4vw, 2.125rem);
  }

  .t-name {
    grid-column: 1;
    margin-top: 14px;
    font: 600 1.125rem/1.3 var(--sans);
    color: var(--brown);
  }

  .t-text {
    grid-column: 1;
    margin-top: 8px;
    font-size: 1rem;
    line-height: 1.5;
    color: #4a3b2f;
  }

  .t-art {
    grid-column: 2;
    grid-row: 2 / 4;
    align-self: end;
  }

  .t-go {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--rule-soft);
    font: 600 0.9375rem/1 var(--sans);
    letter-spacing: 0.06em;
    color: var(--brown);
  }

  .t-go :global(svg) {
    width: 1.1em;
    height: 1.1em;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .tile:hover .t-go :global(svg) {
    transform: translateX(4px);
  }

  .note {
    margin-top: 14px;
    font-size: 0.8125rem;
    color: #6b5a4a;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero :global(.hero-sygnet) {
      display: none;
    }

    .hero :global(.hero-sygnet-sm) {
      display: block;
      width: 88px;
      margin-bottom: 24px;
    }

    .tiles {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .tile {
      grid-template-columns: minmax(0, 1fr);
    }

    .t-art {
      grid-column: 1;
      grid-row: auto;
      margin-top: 18px;
      max-width: 280px;
    }

    .button.light {
      font-size: 0.9375rem;
      letter-spacing: 0.04em;
      padding: 0 18px;
    }
  }
</style>
