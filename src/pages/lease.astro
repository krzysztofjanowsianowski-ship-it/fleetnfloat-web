---
import Division from "../layouts/Division.astro";
import CarIllustration from "../components/CarIllustration.astro";
import AvailabilityCalendar from "../components/AvailabilityCalendar.astro";
import Arrow from "../components/Arrow.astro";
import { flota, formyNajmu, cennik } from "../data/flota";
---

<Division
  id="lease"
  lead="Oferujemy najem okazjonalny, krótko- i długoterminowy oraz leasing operacyjny i finansowy. Udostępniamy samochody z własnej floty, a jeśli klient sam wybierze pojazd, finansujemy jego zakup."
>
  <section aria-label="Formy najmu">
    <ul class="offers">
      {
        formyNajmu.map((f) => (
          <li class="offer">
            <h3>{f.nazwa}</h3>
            <p class="period">{f.okres}</p>
            <p class="desc">{f.opis}</p>
            <a class="action" href={f.href}>
              {f.akcja} <Arrow />
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="fleet" aria-labelledby="flota-tytul">
    <h2 id="flota-tytul" class="h-sec">Nasze samochody</h2>
    <ul class="cars">
      {
        flota.map((a) => (
          <li class="car-card">
            {a.zdjecia?.length ? (
              <a class="photo" href={`/lease/${a.id}/`} aria-hidden="true" tabindex="-1">
                <img src={a.zdjecia[0].plik} alt="" width="800" height="500" loading="lazy" decoding="async" />
              </a>
            ) : (
              <div class="art">
                <CarIllustration nadwozie={a.nadwozie} lakier={a.lakier} dach={a.dach} tytul={`${a.nazwa}, ${a.kolor}: ilustracja poglądowa`} />
              </div>
            )}
            <div class="info">
              <h3>{a.opis ? <a href={`/lease/${a.id}/`}>{a.nazwa}</a> : a.nazwa}</h3>
              <dl>
                {a.rok && (
                  <div>
                    <dt>Rocznik</dt>
                    <dd>{a.rok}</dd>
                  </div>
                )}
                <div>
                  <dt>Kolor</dt>
                  <dd>{a.kolor}</dd>
                </div>
              </dl>
              <div class="links">
                {a.opis && (
                  <a class="action" href={`/lease/${a.id}/`}>
                    Szczegóły <Arrow />
                  </a>
                )}
                <a class="action" href="#kalendarz" data-wybierz-auto={a.id}>
                  Sprawdź dostępność <Arrow />
                </a>
              </div>
            </div>
          </li>
        ))
      }
    </ul>
    <p class="fine">Zdjęcia i ilustracje są poglądowe: pokazują ten sam model, ale nie nasz egzemplarz. Zdjęcia naszych samochodów pojawią się po sesji zdjęciowej.</p>
  </section>

  <section class="prices" aria-labelledby="cennik-tytul">
    <h2 id="cennik-tytul" class="h-sec">Cennik najmu okazjonalnego</h2>
    <table class="spis price-table">
      <thead>
        <tr><th scope="col">Długość najmu</th><th scope="col">Cena za dobę (netto)</th></tr>
      </thead>
      <tbody>
        {
          cennik.map((c) => (
            <tr>
              <th scope="row">{c.opis}</th>
              <td>{c.cena} zł</td>
            </tr>
          ))
        }
      </tbody>
    </table>
    <p class="fine">Stawka obejmuje każdy z trzech samochodów i zależy od łącznej liczby dób najmu. Do cen netto należy doliczyć VAT. Ceny najmu krótko- i długoterminowego oraz leasingu ustalamy indywidualnie.</p>
  </section>

  <div class="cal-wrap">
    <AvailabilityCalendar />
  </div>
</Division>

<style>
  .offers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--gold);
  }

  .offer {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 22px 24px 0;
  }

  .offer + .offer {
    padding-left: 22px;
    border-left: 1px solid var(--rule);
  }

  .offer h3 {
    font: 600 1.1875rem/1.25 var(--sans);
    color: var(--navy-ink);
  }

  .period {
    font: 600 1rem/1.2 var(--serif);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-deep-text);
  }

  .desc {
    flex: 1;
    font-size: 1rem;
    line-height: 1.55;
    color: #2b4466;
  }

  .offer .action {
    align-self: flex-start;
    margin-top: 6px;
  }

  .fleet {
    margin-top: clamp(56px, 7vw, 88px);
  }

  .cars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .car-card {
    border: 1px solid var(--rule);
    background: #fff;
  }

  .art {
    padding: 28px 22px 14px;
    background: var(--beige);
  }

  .photo {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--beige);
  }

  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .photo:hover img {
    transform: scale(1.03);
  }

  .info h3 a {
    color: inherit;
    text-decoration: none;
  }

  .info h3 a:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
  }

  .info {
    padding: 18px 20px 22px;
  }

  .info h3 {
    font: 600 1.25rem/1.2 var(--serif);
    letter-spacing: 0.06em;
    color: var(--navy);
  }

  .info dl {
    margin: 12px 0 16px;
  }

  .info dl div {
    display: grid;
    grid-template-columns: 6rem 1fr;
    padding: 6px 0;
    border-bottom: 1px solid var(--rule-soft);
    font-size: 0.9375rem;
  }

  .info dt {
    color: #4a5f7d;
  }

  .info dd {
    margin: 0;
    color: var(--navy-ink);
  }

  .prices {
    margin-top: clamp(56px, 7vw, 88px);
    max-width: 40rem;
  }

  .price-table {
    margin-top: 16px;
  }

  .price-table td {
    font: 600 1.0625rem/1.2 var(--sans);
    color: var(--navy-ink);
    text-align: right;
  }

  .price-table thead th:last-child {
    text-align: right;
  }

  .cal-wrap {
    margin-top: clamp(56px, 7vw, 88px);
  }

  @media (max-width: 1000px) {
    .offers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .offer:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .offer:nth-child(n + 3) {
      border-top: 1px solid var(--rule);
    }

    .cars {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .offers,
    .cars {
      grid-template-columns: minmax(0, 1fr);
    }

    .offer,
    .offer + .offer {
      padding-left: 0;
      border-left: 0;
    }

    .offer + .offer {
      border-top: 1px solid var(--rule);
    }
  }
</style>
